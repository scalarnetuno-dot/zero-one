// ════════════════════════════════════════════════════════════════════════════
// CAPA — GERADA pela pipeline. Dois modos, um só desenho:
//   mode = "front"  → só a capa, no tamanho do miolo (PDF digital e EPUB)
//   mode = "wrap"   → contracapa + lombada + capa, com sangria (KDP impresso)
// A largura da lombada vem do número real de páginas.
//
// Quando o livro declara `cover_palette`, a contracapa e a lombada assumem as
// cores da arte da capa — o embrulho vira uma peça só.
// ════════════════════════════════════════════════════════════════════════════

#let accent   = rgb("{{ accent }}")
#let ink      = rgb("{{ tk.color.ink }}")
#let ink-soft = rgb("{{ tk.color.ink_soft }}")
#let ink-faint = rgb("{{ tk.color.ink_faint }}")
#let paper    = rgb("{{ tk.color.paper }}")
#let sans     = "{{ tk.type.sans }}"
#let serif    = "{{ tk.type.serif }}"

// paleta da capa (vinda do book.yaml) ou o neutro da coleção
#let c-bg    = rgb("{{ palette.bg }}")
#let c-panel = rgb("{{ palette.panel }}")
#let c-mark  = rgb("{{ palette.accent }}")
#let c-ink   = rgb("{{ palette.ink }}")
#let c-soft  = rgb("{{ palette.ink_soft }}")

#let trim-w = {{ trim_w }}mm
#let trim-h = {{ trim_h }}mm
#let spine  = {{ spine }}mm
{% if mode == "wrap" %}
#let bleed  = {{ bleed }}mm
{% else %}
#let bleed  = 0mm
{% endif %}
#let safe   = 9mm

#set page(
{% if mode == "wrap" %}
  width: trim-w * 2 + spine + bleed * 2,
{% else %}
  width: trim-w,
{% endif %}
  height: trim-h + bleed * 2,
  margin: 0pt,
  fill: {% if mode == "wrap" %}c-bg{% else %}paper{% endif %},
)
#set text(font: sans, fill: ink, lang: "{{ lang }}")
#set par(justify: false, first-line-indent: 0pt, leading: 0.62em)

#let caps(body, color: ink-soft, size: 8pt, weight: 600) = text(
  size: size, weight: weight, fill: color, tracking: 0.08em,
)[#upper(body)]

// ── A CAPA (usada nos dois modos) ───────────────────────────────────────────
{% if cover_full and cover_image %}
// Arte fechada: a imagem É a capa. A pipeline não sobrepõe tipografia nenhuma.
#let front = block(width: trim-w, height: trim-h, clip: true)[
  #image("{{ cover_image }}", width: 100%, height: 100%, fit: "cover")
]
{% else %}
#let front = block(width: trim-w, height: trim-h)[
  #pad(x: safe + 3mm, y: safe + 6mm)[
    #caps("{{ collection_name }}", color: accent, size: 9pt)
    {% if volume %}
    #h(3mm)
    #text(size: 9pt, fill: ink-faint, weight: 300)[{{ volume }}]
    {% endif %}
    #v(10mm)
    #text(size: 31pt, weight: 700, tracking: -0.02em)[{{ title }}]
    {% if subtitle %}
    #v(4mm)
    #block(width: 88%)[
      #text(font: serif, size: 11.5pt, style: "italic", fill: ink-soft)[{{ subtitle }}]
    ]
    {% endif %}
    {% if cover_image %}
    #v(1fr)
    #align(center)[#image("{{ cover_image }}", width: 74%)]
    {% endif %}
    #v(1fr)
    #line(length: 22mm, stroke: 1pt + accent)
    #v(5mm)
    #text(size: 12pt, weight: 600)[{{ author }}]
  ]
]
{% endif %}

{% if mode == "wrap" %}
// ── CONTRACAPA ──────────────────────────────────────────────────────────────
// Mesmo mundo visual da capa: fundo escuro, painel de cor, marca vermelha.
#place(top + left, dx: bleed, dy: bleed, block(width: trim-w, height: trim-h)[
  #pad(x: safe + 3mm, y: safe + 5mm)[
    // painel do topo, como o da arte
    #block(
      fill: c-panel, inset: (x: 5mm, y: 3.5mm), below: 9mm,
    )[
      #text(size: 9pt, weight: 700, fill: c-bg, tracking: 0.1em)[
        #upper("{{ publisher }}")
      ]
    ]

    #text(size: 21pt, weight: 700, fill: c-ink, tracking: -0.01em)[{{ title }}]
    {% if subtitle %}
    #v(2.5mm)
    #block(width: 92%)[
      #text(size: 10pt, fill: c-panel, weight: 500)[{{ subtitle }}]
    ]
    {% endif %}

    #v(4mm)
    #line(length: 24mm, stroke: 1.6pt + c-mark)
    #v(6mm)

    #block(width: 94%)[
      #text(font: serif, size: 9.5pt, fill: c-soft)[{{ description }}]
    ]

    #v(7mm)
    {% for item in bullets %}
    #block(below: 3mm)[
      #text(size: 9pt, fill: c-mark, weight: 700)[▸]
      #h(2.5mm)
      #text(size: 9pt, fill: c-ink)[{{ item }}]
    ]
    {% endfor %}

    #v(1fr)

    #grid(columns: (1fr, auto), align: bottom + left,
      block[
        #text(size: 9pt, weight: 700, fill: c-ink)[{{ author }}]
        #v(2.5mm)
        #text(size: 7.5pt, fill: c-panel, weight: 600, tracking: 0.08em)[
          #upper("{{ collection_name }}{% if volume %} · {{ volume }}{% endif %}")
        ]
        #v(1.5mm)
        #line(length: 14mm, stroke: 1.2pt + c-mark)
      ],
      // área reservada do código de barras — a KDP imprime aqui
      block(width: 52mm, height: 32mm, fill: white, inset: 3mm, radius: 0pt)[
        #set align(center + horizon)
        #text(size: 6.5pt, fill: rgb("#9A9A9A"))[
          {% if isbn %}ISBN {{ isbn }}{% else %}código de barras{% endif %}
        ]
      ]
    )
  ]
])

// ── LOMBADA ─────────────────────────────────────────────────────────────────
#place(top + left, dx: bleed + trim-w, dy: 0mm, block(
  width: spine, height: trim-h + bleed * 2, fill: c-bg,
)[
  {% if spine_text %}
  #place(top + center, dy: bleed + 12mm,
    block(width: spine * 0.45, height: spine * 0.45, fill: c-mark))
  #place(center + horizon, rotate(90deg, reflow: false, block(width: trim-h - 30mm)[
    #set align(center)
    #text(size: 11pt, weight: 700, fill: c-ink)[{{ title }}]
    #h(7mm)
    #text(size: 9pt, fill: c-panel)[{{ author }}]
  ]))
  #place(bottom + center, dy: -(bleed + 12mm),
    text(size: 6.5pt, fill: c-panel, weight: 600, tracking: 0.08em)[
      #upper("{{ publisher }}")
    ])
  {% endif %}
])

{% if cover_full and cover_image %}
#place(top + left, dx: bleed + trim-w + spine, dy: 0mm, block(
  width: trim-w + bleed, height: trim-h + bleed * 2, clip: true,
)[
  #image("{{ cover_image }}", width: 100%, height: 100%, fit: "cover")
])
{% else %}
#place(top + left, dx: bleed + trim-w + spine, dy: bleed, front)
{% endif %}
{% else %}
#front
{% endif %}
